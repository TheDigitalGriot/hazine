{
  "name": "hazine-living-treasury-experience",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-pages.mjs",
    "build:vite": "vite build",
    "preview": "vite preview",
    "check": "node scripts/verify-project.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm run check && pnpm run test && pnpm run build",
    "verify:capture": "node scripts/capture-acceptance.mjs",
    "inspect:assets": "node scripts/inspect-assets.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "generate:models": "node scripts/generate-models.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.1.1",
    "@theatre/core": "0.7.2",
    "animejs": "4.5.0",
    "gsap": "3.15.0",
    "postprocessing": "6.39.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "three-globe": "2.45.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@vitejs/plugin-react": "6.1.1",
    "gltfjsx": "6.5.3",
    "leva": "0.10.1",
    "meshoptimizer": "1.2.0",
    "vite": "8.2.2"
  }
}
